local BUNDLE_NAME = "BUNDLE NAME HERE"

local copy = setclipboard or toclipboard or (syn and syn.setclipboard) or (fluxus and fluxus.setclipboard)

local player = game:GetService("Players").LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local humanoid = char:WaitForChild("Humanoid")
local desc = humanoid:GetAppliedDescription()
local bodyColors = char:FindFirstChildOfClass("BodyColors")

-- r15 has the same 6 colors as r6, nothing to convert
-- {BodyColors name, HumanoidDescription name}
local colorProps = {
	{"HeadColor3", "HeadColor"},
	{"TorsoColor3", "TorsoColor"},
	{"LeftArmColor3", "LeftArmColor"},
	{"RightArmColor3", "RightArmColor"},
	{"LeftLegColor3", "LeftLegColor"},
	{"RightLegColor3", "RightLegColor"},
}

-- r6 can't show layered accessories, so only the 8 rigid types
local rigidTypes = {"Hat", "Hair", "Face", "Neck", "Shoulder", "Front", "Back", "Waist"}

-- only used if GetAccessories errors
local accessoryProps = {
	"HatAccessory", "HairAccessory", "FaceAccessory", "ShouldersAccessory",
	"NeckAccessory", "FrontAccessory", "BackAccessory", "WaistAccessory",
}

local function rgb(c)
	return string.format("Color3.fromRGB(%d, %d, %d)",
		math.round(c.R * 255), math.round(c.G * 255), math.round(c.B * 255))
end

local colors = ""
for _, p in ipairs(colorProps) do
	local col = bodyColors and bodyColors[p[1]] or desc[p[2]]
	colors = colors .. string.format('\t\t["%s"] = %s,\n', p[1], rgb(col))
end

local accessories = {}
local seen = {}

local function addAccessory(id)
	if id and id ~= 0 and not seen[id] then
		seen[id] = true
		table.insert(accessories, id)
	end
end

-- true = include the rigid ones too
local ok, list = pcall(function()
	return desc:GetAccessories(true)
end)

if ok then
	for _, acc in ipairs(list) do
		if not acc.IsLayered and table.find(rigidTypes, acc.AccessoryType.Name) then
			addAccessory(acc.AssetId)
		end
	end
else
	for _, prop in ipairs(accessoryProps) do
		for id in tostring(desc[prop]):gmatch("%d+") do
			addAccessory(tonumber(id))
		end
	end
end

local accessoryLines = ""
for _, id in ipairs(accessories) do
	accessoryLines = accessoryLines .. string.format("\t\t%d,\n", id)
end

-- %d so long ids don't turn into 1e+14
local shirt = desc.Shirt ~= 0 and string.format("%d", desc.Shirt) or "nil"
local pants = desc.Pants ~= 0 and string.format("%d", desc.Pants) or "nil"

local result = string.format([[
["%s"] = {
	["Body Color"] = {
%s	},

	["Accessory"] = {
%s	},

	["TailAccessory"] = nil,

	["Clothes"] = {
		["Shirt"] = %s,
		["Pants"] = %s,
	},

	["TClothes"] = {
		["Shirt"] = nil,
		["Pants"] = nil,
	},

	["Clothing"] = {
		"Roblox Breasts Clothing",
		"Roblox Shirt",
		"Roblox Butt Shirt",
		"Roblox Pants",
	},

	["Preset"] = {
		Tone = "Base",
		Face = false,
		AccessorySizeLock = false,
		BodyPartPhysics = false,
		PhysicsObeyGravity = true,
		RealtimeBodyTransparency = true,
		PositionPhysicsMultiply = 1,
		RotationPhysicsMultiply = 4,
		BreastsScale = 1,
		ButtsScale = 1,
		LegsScale = 1,
		BreastsType = 1,
		TorsoType = 1,
		ArmType = 1,
		LegsType = 1,
		ButtType = 1,
		HardcoreHP = false,
		TopHP = nil,
		BottomHP = nil,
		DamageSFX = nil,
		Volume = nil,
	},
}]], BUNDLE_NAME, colors, accessoryLines, shirt, pants)

print(result)

if copy then
	local copied, err = pcall(copy, result)
	if not copied then
		warn("Couldn't copy: " .. tostring(err))
	end
else
	warn("Clipboard not supported.")
end
